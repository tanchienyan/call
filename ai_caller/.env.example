# ─── Core AI pipeline (required) ───

# OpenAI (LLM — GPT-4o for agent + QA + compliance audit)
OPENAI_API_KEY=sk-...

# Deepgram (speech-to-text, Nova-3 multilingual)
DEEPGRAM_API_KEY=...

# ElevenLabs (text-to-speech, Flash v2.5 + Multilingual v2)
ELEVENLABS_API_KEY=sk_...


# ─── Twilio (phone calls — optional for browser-only demo) ───

TWILIO_ACCOUNT_SID=AC...
# Use API keys (preferred) ...
TWILIO_API_KEY_SID=SK...
TWILIO_API_KEY_SECRET=...
# ... or a classic auth token (fallback)
# TWILIO_AUTH_TOKEN=...
TWILIO_PHONE_NUMBER=+1...
# For Malaysian caller-ID on +60 legs (optional, healthcare pivot)
# TWILIO_PHONE_NUMBER_MY=+60...


# ─── Server ───

# Public URL when running behind ngrok for Twilio webhooks
BASE_URL=https://your-subdomain.ngrok-free.dev
PORT=8000
